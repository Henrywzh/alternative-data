# hk_local_consumer: keep only the durable cross-run history accumulators.
# The rest of data/normalized/hk_local_consumer/ is disposable per-run
# scratch output (uuid-scoped parquet/csv dumps) and stays ignored.
# - afcd_category_history.csv: AFCD's wholesale-prices feed publishes
#   same-day data only (no upstream archive), so this file is the sole
#   real source of "over time" history for it.
# - consumer_council_oilprice_history.csv: Oil Price Watch's trend CSV
#   goes back to 2009, but nothing in CI refreshes it -- it is filled by
#   scripts/backfill_consumer_council_oilprice.py, run manually. The
#   local-consumer artifact builder reads this file unconditionally, with
#   no missing-cache caveat (unlike the Price Watch archive's
#   archive_validation check), so an unignored-but-uncommitted copy of
#   this file previously meant the oil-price chart silently disappeared
#   from any build that did not happen to run on a machine that had
#   manually backfilled it.
!data/normalized/hk_local_consumer/
data/normalized/hk_local_consumer/*
!data/normalized/hk_local_consumer/afcd_category_history.csv
!data/normalized/hk_local_consumer/consumer_council_oilprice_history.csv

# hk_transport airline pair-trading research pack: this pipeline's stages
# emit CSV only (no parquet twin, unlike the daily-scrape datasets the
# repo-size CSV ban above assumes), and its tests read those CSVs directly.
# Without this override the files are never committed, so a clean CI
# checkout is missing every stage's input and ~130 downstream tests fail
# with FileNotFoundError.
!data/normalized/hk_transport/
data/normalized/hk_transport/*
!data/normalized/hk_transport/*.csv
!data/normalized/hk_transport/*.parquet
# Pre-event frozen snapshots: written once per forecast_asof and never
# recomputed after the reports, so they are tracked like any other stage
# output (the audit trail depends on them surviving in the repo).
!data/normalized/hk_transport/snapshots/
data/normalized/hk_transport/snapshots/*
!data/normalized/hk_transport/snapshots/*.csv

# Local dashboard-verification by-products. Canonical dashboard artifacts
# (hk-*-artifact*.json) live in both these .generated directories and are
# still tracked; these patterns only match the packaging tool's own
# temporary screenshots and test/debug exports, which must never be staged.
# (131 of these were committed by accident in 8c393d4 and removed in the
# commit that added this rule -- this rule exists so it doesn't recur.)
/.generated/*.verification-failure*.png
/.generated/*.tmp-*.png
/.generated/debug_*.html
/.generated/test_*.html
/.generated/test_*.json
/.generated/test_*.png
apps/asia-markets-dashboard/.generated/*.verification-failure*.png
apps/asia-markets-dashboard/.generated/portable-verification-failure-*.png

# asia-backtest input bundle: the long-form builder fails closed on these, so a
# clean checkout cannot run the backtest tests without them. One patronage
# snapshot is pinned as the CI input (the builder picks the newest valid file,
# so a fresher local capture still wins locally).
!data/raw/hk_transport/
data/raw/hk_transport/*
!data/raw/hk_transport/mtr_patronage_20260817_140455.json
!docs/asia-markets/REAL_ESTATE_SHKP_IRIS_ORDER_PLAN.csv
!docs/asia-markets/REAL_ESTATE_SHKP_IRIS_PILOT_TEMPLATE.csv
!docs/asia-markets/REAL_ESTATE_SHKP_PHASE_DECISION_TEMPLATE.csv

