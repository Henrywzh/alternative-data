# Copy to `.streamlit/secrets.toml` for local dev (gitignored), and/or paste the
# relevant keys into the Streamlit Community Cloud app's Secrets settings.
#
# All keys are OPTIONAL — the dashboard works with none of them set.

# Where the dashboard reads datasets from:
#   "remote" (default) -> fetch from raw.githubusercontent.com, refreshes without reboot
#   "local"            -> read the local repo checkout only (offline / fast dev)
DATA_SOURCE = "remote"

# Optional GitHub token. The repo is public, so this is NOT required; it only
# raises the commit-SHA API rate limit from 60/hr to 5000/hr (per shared IP).
# GITHUB_TOKEN = "ghp_xxx"

# Optional overrides (defaults: Henrywzh/alternative-data on main).
# DATA_REPO_SLUG = "Henrywzh/alternative-data"
# DATA_BRANCH = "main"

# Optional access code for the Semiconductor Analysis TODO tab.
# Keep the real value only in local `.streamlit/secrets.toml` or Streamlit Cloud secrets.
# PRIVATE_PANEL_ACCESS_CODE = "change-me"
