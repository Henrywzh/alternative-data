---
import BaseLayout from "../layouts/BaseLayout.astro";
import realEstateStatus from "../data/dashboard-status.json";
import localConsumerStatus from "../data/dashboard-status-hk-local-consumer.json";
import utilitiesStatus from "../data/dashboard-status-hk-utilities.json";
import transportStatus from "../data/dashboard-status-hk-transport.json";
import reitStatus from "../data/dashboard-status-hk-reit.json";

const liveSectors = [
  { status: realEstateStatus, name: "Hong Kong Real Estate", href: "/sectors/hk-real-estate/" },
  { status: localConsumerStatus, name: "Hong Kong Local Consumer", href: "/sectors/hk-local-consumer/" },
  { status: utilitiesStatus, name: "Hong Kong Utilities & Infrastructure", href: "/sectors/hk-utilities/" },
  { status: transportStatus, name: "Hong Kong Transport & Aviation", href: "/sectors/hk-transport/" },
  { status: reitStatus, name: "Hong Kong REITs", href: "/sectors/hk-reit/" },
];

const sectors = [
  ...liveSectors.map((sector, index) => ({
    code: String(index + 1).padStart(2, "0"),
    name: sector.name,
    state: sector.status.overall_status,
    detail: `${sector.status.live_sources} live measures · data through ${sector.status.data_as_of}`,
    href: sector.href,
    action: "Open monitor",
    isLive: true,
  })),
  {
    code: "06",
    name: "Stablecoin & Crypto",
    state: "Research ready",
    detail: "Source map and company coverage complete; dashboard not yet published.",
    href: "#future-sectors",
    action: "Planned",
    isLive: false,
  },
  {
    code: "07",
    name: "Commercial Aerospace",
    state: "Research ready",
    detail: "Company and signal framework complete; dashboard not yet published.",
    href: "#future-sectors",
    action: "Planned",
    isLive: false,
  },
  {
    code: "08",
    name: "Consumer Trends",
    state: "Research",
    detail: "Company list established; source access remains uneven.",
    href: "#future-sectors",
    action: "Planned",
    isLive: false,
  },
];

const latestGeneratedAt = liveSectors.reduce(
  (max, sector) => (sector.status.generated_at > max ? sector.status.generated_at : max),
  liveSectors[0].status.generated_at
);
const totalLiveMeasures = liveSectors.reduce((sum, sector) => sum + sector.status.live_sources, 0);
---

<BaseLayout
  title="Asia Markets — Research Monitors"
  description="Source-backed Asia market research dashboards and published data snapshots."
>
  <section class="workspace-intro">
    <div>
      <p class="eyebrow">Research monitors / 2026</p>
      <h1>Sector signals,<br />with the source trail intact.</h1>
    </div>
    <div class="intro-meta">
      <span>Latest release</span>
      <strong>{latestGeneratedAt.slice(0, 10)}</strong>
      <span>{totalLiveMeasures} live measures across {liveSectors.length} published sectors</span>
    </div>
  </section>

  <section class="sector-index" aria-labelledby="sector-heading">
    <div class="section-heading">
      <h2 id="sector-heading">Sector index</h2>
      <p>Published surfaces first; research-only sectors remain clearly labeled.</p>
    </div>
    <div class="sector-list">
      {sectors.map((sector) => (
        <a
          class:list={["sector-row", sector.isLive && "sector-row-live"]}
          href={sector.href}
          aria-label={`${sector.name}: ${sector.action}`}
        >
          <span class="sector-code">{sector.code}</span>
          <span class="sector-main">
            <strong>{sector.name}</strong>
            <small>{sector.detail}</small>
          </span>
          <span class="sector-state"><i aria-hidden="true"></i>{sector.state}</span>
          <span class="sector-action">{sector.action}<b aria-hidden="true">↗</b></span>
        </a>
      ))}
    </div>
  </section>

  <section class="release-panel" id="future-sectors">
    <div>
      <p class="eyebrow">Portable release</p>
      <h2>Take these monitors offline.</h2>
      <p>
        Each hosted page and its downloadable HTML are generated from the same validated snapshot and
        contain identical dashboard bytes.
      </p>
    </div>
    <div class="release-actions">
      {liveSectors.map((sector) => (
        <a class="primary-action" href={`/exports/${sector.status.attachment_filename}`} download>
          Download {sector.name} HTML
        </a>
      ))}
      <a class="text-action" href="/data-status/">Inspect source status →</a>
    </div>
  </section>
</BaseLayout>
