  "exclusions": {
    "asia_markets": [
      {
        "id": "private_research",
        "reason": "Events & Consensus, ETF Monitor, Global Market Regime, Hong Kong Flows and Control Tower require their existing private read contracts."
      },
      {
        "id": "agency_property_data",
        "reason": "Centaline/Midland redistribution review is outside this public subset."
      },
      {
        "id": "crypto_aerospace",
        "reason": "Mixed-date KPI summaries need per-metric provenance adapters before export."
      },
      {
        "id": "other_dashboard_detail",
        "reason": "V1 selects the listed official headline datasets; other history, forecasts and private overlays remain in their canonical surfaces."
      }
    ],
    "alternative_signals": [
      {
        "id": "licensed_memory_prices",
        "reason": "ADATA/DRAMeXchange payloads, images and derived price baskets are excluded pending redistribution review."
      },
      {
        "id": "minerals_google_trends",
        "reason": "Local processed datasets and source permissions need separate adapters; not read by V1."
      },
      {
        "id": "apps_rankings",
        "reason": "App rankings and rolling-window usage are not exported as unqualified demand signals."
      },
      {
        "id": "positions_theses_news",
        "reason": "Positions, private theses, credentials, raw responses and full news bodies are never exporter inputs."
      },
      {
        "id": "npm_github_hf_momentum",
        "reason": "Zero latest npm observations, changing GitHub sampling and rolling HF downloads require separate coverage gates."
      }
    ]
  },
  "rules": [
    {
      "rule_id": "hk.unemployment.ge_4pct.v1",
      "record_id": "hk-labour-market/labour_force_card",
      "field": "unemployment_rate",
      "operator": "ge",
      "threshold": 0.04,
      "unit": "fraction",
      "rationale": "Review labour-market weakness when the published rolling-three-month unemployment rate is at least 4%."
    },
    {
      "rule_id": "hk.rvd.price.mom_abs_2pct.v1",
      "record_id": "hk-real-estate/rvd_price_card",
      "field": "period_change",
      "operator": "abs_ge",
      "threshold": 0.02,
      "unit": "fraction",
      "rationale": "Review a reported residential-price MoM move of at least 2%; provisional observations remain flagged."
    },
    {
      "rule_id": "tw.revenue.yoy_abs_20pct.v1",
      "section_id": "taiwan_semiconductor",
      "field": "yoy_pct",
      "operator": "abs_ge",
      "threshold": 20.0,
      "unit": "percent",
      "rationale": "Review an issuer-reported monthly revenue YoY move of at least 20%; this is not an earnings forecast."
    }
  ]
}
