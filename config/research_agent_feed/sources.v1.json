          "source_url": "https://www.censtatd.gov.hk/api/get.php?id=210-06101&lang=en&full_series=1",
          "date_field": "observation_date",
          "cadence": "rolling_three_month",
          "fields": {
            "labour_force_thousands": "thousand_people",
            "employed_thousands": "thousand_people",
            "unemployment_rate": "fraction",
            "underemployment_rate": "fraction"
          },
          "freshness_check": "labour.unemployment",
          "health_dataset": "labour_force_monthly"
